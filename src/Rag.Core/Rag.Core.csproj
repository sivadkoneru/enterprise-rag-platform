<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>Core abstractions, models, chunking strategies, parsers, and ingestion/query pipelines for the Enterprise RAG Platform. Local file sources and in-memory/file stores are built in; cloud and database backends ship as separate Rag.Providers.* packages.</Description>
    <PackageTags>rag;retrieval-augmented-generation;ai;embeddings;vector-search;dotnet</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <!-- Rag.Core.Tests exercises the internal Common primitives directly. -->
    <InternalsVisibleTo Include="Rag.Core.Tests" />
  </ItemGroup>
  <ItemGroup>
    <!--
      No FrameworkReference on Microsoft.AspNetCore.App: this package is consumed by worker
      services and console apps as well as web apps, and the shared-framework reference would
      force every consumer to be an ASP.NET Core application. Only the Extensions abstractions
      actually used are referenced.
    -->
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="Markdig" />
    <PackageReference Include="PdfPig" />
  </ItemGroup>
</Project>
