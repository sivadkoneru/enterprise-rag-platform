    <ProjectReference Include="..\Rag.Core\Rag.Core.csproj" />
    <ProjectReference Include="..\Rag.Providers.Aws\Rag.Providers.Aws.csproj" />
    <ProjectReference Include="..\Rag.Providers.AzureBlob\Rag.Providers.AzureBlob.csproj" />
    <ProjectReference Include="..\Rag.Providers.Cosmos\Rag.Providers.Cosmos.csproj" />
    <ProjectReference Include="..\Rag.Providers.Mongo\Rag.Providers.Mongo.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Rag.Cli.Tests" />
  </ItemGroup>
</Project>
