# Copy to .env.client and replace every blank credential locally before starting Compose.
# Do not commit .env.client or generated.env.client.
RAG_API_KEY=
RAG_API_URL=http://api:8080
RAG_PLAYGROUND_MODE=private-live
RAG_PLAYGROUND_ORIGIN=http://localhost:3000
PLAYGROUND_PORT=3000
CLIENT_DOCUMENTS_PATH=./client-documents
COMPOSE_PROFILES=local-storage

# Local source access: place files under ./client-documents on the host.
LOCAL_SOURCE_ALLOWED_ROOTS=/documents
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://+:8080

# Deterministic provider needs no external model credential. Configure these for HTTP providers.
LLM_PROVIDER=deterministic
LLM_API_KEY=
LLM_EMBEDDING_ENDPOINT=
LLM_EMBEDDING_MODEL=
LLM_EMBEDDING_DIMENSIONS=1536
LLM_CHAT_ENDPOINT=
LLM_MAX_OUTPUT_TOKENS=1024
LLM_CHAT_MODEL=
LLM_SYSTEM_PROMPT=Answer only from the supplied context. If the answer is not present, say you do not know. Always cite sources.
LLM_TIMEOUT_SECONDS=60
LLM_RETRY_COUNT=3
LLM_RETRY_BACKOFF_SECONDS=2
RERANKER_ENDPOINT=
RERANKER_API_KEY=
RERANKER_MODEL=
RERANKER_TIMEOUT_SECONDS=30

# Container-network defaults. Override endpoints only when using an external service.
DOC_STORE=mongo
JOB_STORE=mongo
MONGO_CONNECTION_STRING=mongodb://mongo:27017
MONGO_DATABASE=rag
MONGO_CHUNKS_COLLECTION=chunks
MONGO_DOCUMENTS_COLLECTION=documents
MONGO_JOBS_COLLECTION=ingestion_jobs
VECTOR_STORE=elasticsearch
ELASTICSEARCH_URI=http://elasticsearch:9200
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=
ELASTICSEARCH_INDEX=rag-chunks
ELASTICSEARCH_VECTOR_DIMENSIONS=1536

CHUNKING_STRATEGY=recursive
CHUNK_SIZE=800
CHUNK_OVERLAP=120
SEMANTIC_DISTANCE_THRESHOLD=0.22
INGESTION_MAX_PARALLELISM=4
QUERY_TOP_K=5
QUERY_MODE=vector
QUERY_RERANKER=false
QUERY_MIN_RELEVANCE=0.7
QUERY_NEIGHBORS=false
QUERY_MAX_CONTEXT_TOKENS=4096
CLOUD_SOURCE_ALLOWED_PREFIXES=

# Optional AWS S3 source. Credentials are read by the AWS SDK from these environment names.
S3_REGION=us-east-1
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=true
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Optional Azure Blob source.
AZURE_BLOB_CONNECTION_STRING=
AZURE_BLOB_SERVICE_URI=
