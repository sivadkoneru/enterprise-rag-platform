<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="AWSSDK.S3" Version="3.7.415" />
    <PackageVersion Include="Azure.Storage.Blobs" Version="12.23.0" />
    <PackageVersion Include="coverlet.collector" Version="6.0.2" />
    <PackageVersion Include="FluentAssertions" Version="6.12.1" />
    <PackageVersion Include="Markdig" Version="0.37.0" />
    <PackageVersion Include="Microsoft.Azure.Cosmos" Version="3.45.0" />
    <!--
      Rag.Core targets these abstractions directly instead of taking a FrameworkReference on
      Microsoft.AspNetCore.App, which would force every consumer of the package to be an ASP.NET
      Core application. The 8.0.x line is deliberate: it matches what Http.Resilience already
      depends on and keeps the package usable from the widest range of consumers, while a net10.0
      host still resolves the newer shared-framework assemblies at runtime.
    -->
    <PackageVersion Include="Microsoft.Extensions.Configuration.Abstractions" Version="8.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Binder" Version="8.0.2" />
    <!-- Host-side configuration providers: the CLI reads environment variables, and
         ConfigurationTests builds configuration from a JSON stream. -->
    <PackageVersion Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="8.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Json" Version="8.0.1" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.2" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="8.0.1" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="8.0.1" />
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="8.10.0" />
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="8.0.1" />
    <!-- 8.0.3 rather than 8.0.2: SSH.NET (transitive via Testcontainers) requires at least 8.0.3. -->
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.3" />
    <PackageVersion Include="Microsoft.Extensions.Options" Version="8.0.2" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageVersion Include="MongoDB.Driver" Version="2.30.0" />
    <!-- Transitive pins: Newtonsoft.Json via Microsoft.Azure.Cosmos, SharpCompress/Snappier via MongoDB.Driver. -->
    <PackageVersion Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageVersion Include="PdfPig" Version="0.1.14" />
    <PackageVersion Include="SharpCompress" Version="0.49.1" />
    <PackageVersion Include="Snappier" Version="1.3.1" />
    <!-- Transitive pin: SSH.NET via Testcontainers, bumped past GHSA-q939-rpr3-3284 (fixed in 2026.0.0). -->
    <PackageVersion Include="SSH.NET" Version="2026.0.0" />
    <PackageVersion Include="Swashbuckle.AspNetCore" Version="6.7.3" />
    <PackageVersion Include="System.CommandLine" Version="2.0.0-beta4.22272.1" />
    <PackageVersion Include="Testcontainers" Version="3.9.0" />
    <PackageVersion Include="xunit" Version="2.9.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>
</Project>
