# Provider selection
LLM_PROVIDER=deterministic
DOC_STORE=memory
VECTOR_STORE=memory
CHUNKING_STRATEGY=recursive

# Chunking defaults
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
SEMANTIC_CHUNKING_SIMILARITY_THRESHOLD=0.78

# OpenAI-compatible settings (public OpenAI or Azure OpenAI)
LLM_API_KEY=
LLM_EMBEDDING_ENDPOINT=https://api.openai.com/v1/embeddings
LLM_EMBEDDING_MODEL=text-embedding-3-small
LLM_EMBEDDING_DIMENSIONS=1536
LLM_CHAT_ENDPOINT=https://api.openai.com/v1/chat/completions
LLM_CHAT_MODEL=gpt-4.1-mini
LLM_SYSTEM_PROMPT=Answer only from the supplied context. If the answer is not present, say you do not know. Always cite sources.
LLM_TIMEOUT_SECONDS=60
LLM_RETRY_COUNT=3
LLM_RETRY_BACKOFF_SECONDS=2

# Multi-source async ingestion
INGESTION_MAX_PARALLELISM=4
JOB_STORE=memory

# Directories that local file sources may read from, separated by the platform path separator
# (":" on Linux/macOS, ";" on Windows). Empty means unrestricted, which suits CLI use. The API
# defaults to its working directory; set this when the API must ingest from elsewhere.
LOCAL_SOURCE_ALLOWED_ROOTS=

# Cloud source URI prefixes that s3 and azureblob sources may ingest, comma separated (a comma is
# used rather than the path separator because ":" appears in every "s3://" prefix). Empty means
# unrestricted. Set this when the API accepts source URIs from callers you do not fully trust.
CLOUD_SOURCE_ALLOWED_PREFIXES=
S3_REGION=us-east-1
S3_ENDPOINT=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AZURE_BLOB_ENDPOINT=http://127.0.0.1:10000/devstoreaccount1
AZURE_BLOB_CONNECTION_STRING=DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;BlobEndpoint=http://127.0.0.1:10000/devstoreaccount1;

# MongoDB document store
MONGO_CONNECTION_STRING=mongodb://localhost:27017
MONGO_DATABASE=rag
MONGO_CHUNKS_COLLECTION=chunks
MONGO_DOCUMENTS_COLLECTION=documents
MONGO_JOBS_COLLECTION=ingestion_jobs

# Cosmos DB document store
COSMOS_ENDPOINT=
COSMOS_KEY=
COSMOS_DATABASE=rag
COSMOS_CHUNKS_CONTAINER=chunks
COSMOS_DOCUMENTS_CONTAINER=documents

# Elasticsearch vector store
ELASTICSEARCH_URI=http://localhost:9200
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=
ELASTICSEARCH_INDEX=rag-chunks
ELASTICSEARCH_VECTOR_DIMENSIONS=1536

# API
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5000

# Shared secret required in the X-API-Key header on every endpoint except /health and Swagger.
# Empty means the API accepts unauthenticated requests and logs a warning at startup; set this
# before exposing the API anywhere untrusted.
RAG_API_KEY=
